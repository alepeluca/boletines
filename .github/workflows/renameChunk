name: Renombrar Chunks Masivo

on:
  workflow_dispatch: # Activación manual por botón

jobs:
  run-renamer:
    runs-on: ubuntu-latest

    steps:
    - name: Clonar el repositorio
      uses: actions/checkout@v4

    - name: Configurar entorno de Python
      uses: actions/setup-python@v5
      with:
        python-version: '3.10'

    - name: Ejecutar script de renombrado
      run: python scripts/renombrar_chunks.py

    - name: Guardar cambios de nombres en el repositorio
      run: |
        git config --global user.name "GitHub Actions Bot"
        git config --global user.email "actions@github.com"
        # Agrega los nuevos nombres eliminando del registro los anteriores
        git add json_chunks/
        git commit -m "🤖 Estructura: Formato de nombres de chunks estandarizado a 3 dígitos y código"
        git push
